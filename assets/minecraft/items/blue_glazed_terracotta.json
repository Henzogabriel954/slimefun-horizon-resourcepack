          }
        },
        "model": {
          "type": "minecraft:model",
          "model": "infinityexpansion2:generators/solar_panel"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:block/blue_glazed_terracotta"
    }
  }
