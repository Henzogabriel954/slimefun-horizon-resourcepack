{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "minecraft:custom_data",
    "cases": [
      {
        "when": {
          "PublicBukkitValues": {
            "slimefun:slimefun_item": "CARGO_MANIPULATOR"
          }
        },
        "model": {
          "type": "minecraft:model",
          "model": "fluffymachines:cargo/cargo_manipulator"
        }
      },
      {
        "when": {
          "PublicBukkitValues": {
            "slimefun:slimefun_item": "GN_CUCUMBER"
          }
        },
        "model": {
          "type": "minecraft:model",
          "model": "gastronomicon:ingredient/gn_cucumber"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/sea_pickle"
    }
  }
}